<td style='border: 1px solid #cbd5e1; padding: 6pt 8pt; text-align: center; background-color: #ffffff;'><b><span style="color: #166534; font-weight: bold; background: #dcfce7; padding: 2px 6px; border-radius: 4px;">PASS</span></b></td>
